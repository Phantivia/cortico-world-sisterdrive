{
  "name": "cortico-world-sisterdrive",
  "version": "0.2.0",
  "type": "module",
  "description": "Cortico World for Teach my little sister how to drive: a BepInEx plugin turns game calls into events and feeds the bot's voice to the game. 此乃直播测试验证之后的world，和其他 Persona / 非直播场景的兼容性有待测试。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantivia/cortico-world-sisterdrive.git"
  },
  "homepage": "https://github.com/Phantivia/cortico-world-sisterdrive#readme",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": ["win32"],
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "教妹妹开车",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist/webui.js",
    "plugin/*.cs",
    "plugin/*.csproj",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepack": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json",
    "build:plugin": "dotnet build plugin -c Release -o dist/plugin"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
